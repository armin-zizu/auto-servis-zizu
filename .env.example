# Supabase configuration for cross-device sync
# Copy this file to .env.local and fill in your Supabase project values.
# These are public keys (safe to expose in the browser).

# Found in Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# After deploying to Vercel, also set these two variables in the Vercel
# project settings (Settings -> Environment Variables) so the production
# build has access to them.
